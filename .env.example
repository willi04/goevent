# ════════════════════════════════════════════════════════════════
# GoEvent API — variables d'environnement
# Copier en .env pour le local (jamais commité). En prod : Render → Environment.
# Validées au démarrage par core/config.py : une variable obligatoire
# manquante = l'API refuse de démarrer.
# ════════════════════════════════════════════════════════════════

# ── Obligatoires ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/goevent
SECRET_KEY=change-me-long-random-string          # python -c "import secrets; print(secrets.token_urlsafe(48))"
NGSER_AUTH_TOKEN=xxx
NGSER_PAYMENT_TOKEN=xxx

# ── Environnement ───────────────────────────────────────────────
# development : CORS localhost:5500/8000 autorisé, SSL NGSER non vérifié.
# production  : SSL NGSER vérifié (obligatoire pour des flux d'argent réels).
ENV=development

# ── NGSER (Orange Money) ───────────────────────────────────────
NGSER_BASE_URL=https://securetest.crossroad-africa.net   # URL PROD fournie par NGSER à la bascule
NGSER_SERVICE_NAME=GOEVENT TEST
NGSER_WITHDRAWAL_TOKEN=                          # retraits orga ; vide = retraits impossibles

# ── Cron de réconciliation (doit être IDENTIQUE au secret GitHub Actions) ──
RECONCILE_SECRET=

# ── Slugs d'événements (Hashids) ───────────────────────────────
# OBLIGATOIRE en prod : la valeur par défaut est publique (repo public)
# → les ids d'events deviennent devinables depuis les slugs.
HASHIDS_SALT=

# ── Email (SMTP Gmail, mot de passe d'application) ─────────────
SENDER_EMAIL=
SENDER_PASSWORD=

# ── Monitoring ─────────────────────────────────────────────────
SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=goevent-api@local
