{
  "rewrites": [
    {
      "source": "/e/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|facebookcatalog|Facebot|meta-externalagent|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|Snapchat|Viber|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/api/og-event?slug=:slug"
    },
    {
      "source": "/e/:slug",
      "destination": "/event_detail.html?slug=:slug"
    },
    {
      "source": "/invitations",
      "destination": "/invitations.html"
    },
    {
      "source": "/i/:token",
      "destination": "/invitation.html?t=:token"
    },
    {
      "source": "/suivi/:token",
      "destination": "/suivi.html?t=:token"
    }
  ],
  "headers": [
    {
      "source": "/i/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/suivi/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
